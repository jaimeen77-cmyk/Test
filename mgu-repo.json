{
  "schema": 1,
  "components": [
    {
      "id": "seats_easy_access",
      "version": "0.4.0",
      "title": "Seats Easy Access",
      "description": "Graphical seat controls, memories and Easy Access for iDrive 7.",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "iteriodev-comfort": "0.5.1",
        "mgu-deploy": "0.7.11"
      },
      "kind": "app",
      "path": "apps/seats_easy_access",
      "uninstallable": true,
      "build": {
        "node": "tools/store-build.js",
        "args": ["--template", "seats_easy_access", "--id", "{id}", "--version", "{version}", "--dir", "{dir}", "--language", "ko"],
        "network": false,
        "shared": ["store/runtime", "tools/store-build.js", "localization/ko-additions.tsv"]
      }
    }
  ]
}
